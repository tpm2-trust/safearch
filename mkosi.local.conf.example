# Raw mkosi settings of this build host. Copy to mkosi.local.conf (ignored by
# git) and adjust; mkosi merges it with mkosi.conf. Everything safespace itself
# decides - combinations, users, package source, netroot URLs, release targets,
# erofs threads, Secure Boot keys, the identity's policy - is in safespace.conf
# (this host's choices: safespace.local.conf), not here.
#
# The network UKI's size limits of mkosi.postoutput (NETBOOT.md, "Size of the
# network UKI"): a warning above the first, a stop above the second.

[Build]
#Environment=SAFESPACE_UKI_WARN_MIB=85 SAFESPACE_UKI_LIMIT_MIB=128
