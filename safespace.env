# Settings read by mkosi.postinst (users, VNC). Sourced as bash.
# Users and their ssh keys: users.conf.

USER_GROUPS=wheel           # groups for every user in users.conf (+ docker with the docker group)

# Group remotedesktop: XFCE desktop via TigerVNC, port 5900+VNC_DISPLAY, localhost only (ssh tunnel).
# VNC_DISPLAY must match the vncserver@ line in
# mkosi.profiles/remotedesktop/mkosi.extra/usr/lib/systemd/system-preset/20-remotedesktop.preset.
VNC_USER=                   # empty: first user in users.conf
VNC_DISPLAY=1
# Empty: a random password per build, saved as mkosi.output/<image>.vnc-password.
# VNC uses only the first 8 characters.
VNC_PASSWORD=
