# Checks the served release (Secure Boot signatures against
# /etc/safespace/db.pem, root image against the signed root hash) and records
# the result (safespace-netboot status). Report only: it changes nothing in
# the share. A broken release leaves this unit failed (systemctl --failed).
# Unprivileged and without network: it only reads the share.
[Unit]
Description=Check the releases in the safespace share
Documentation=file:///usr/local/bin/safespace-netboot

[Service]
Type=oneshot
User=safespace
Group=safespace
ExecStart=/usr/local/bin/safespace-netboot verify --changed
UMask=0022
ReadOnlyPaths=@SHARE@
ReadWritePaths=/var/lib/safespace/state
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
