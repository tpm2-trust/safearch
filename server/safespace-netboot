#!/usr/bin/env bash
# Distribution server: check what the share serves. Installed by
# server/setup.sh as /usr/local/bin/safespace-netboot; the units call it, and
# it is the tool for checking by hand. It never changes the share: replacing a
# release is the build host's job (release.sh).
#
#   safespace-netboot status             the served releases and their last check
#   safespace-netboot verify [--changed] [network|usb]
#                                        check the served release(s): Secure Boot
#                                        signature against the pinned db.pem, root
#                                        image against the signed root hash;
#                                        --changed: only what changed since the
#                                        last check (the verify unit). Exit 1 if
#                                        one is broken.
#   safespace-netboot dnsmasq-config     write the dnsmasq configuration for
#                                        DHCP_MODE (safespace-dhcp, as root)
#
# Settings: /etc/safespace/server.conf (SAFESPACE_SERVER_CONF= overrides).
# The share (served by nginx under /safespace/), one release per variant:
#   network/  boot.efi root.img root.verity roothash cmdline release ...
#   usb/      image.raw.zst roothash release ...
# Results of the checks: $STATE/<variant> (outside the share).
set -Eeuo pipefail

log() { printf '%s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,${/^#/!q;s/^# \?//;p}' "$0"; }

SELF=$(readlink -f "$0")
for lib in "$(dirname "$SELF")/../lib/verify.sh" /usr/local/lib/safespace-server/verify.sh; do
	[[ -f $lib ]] && break
done
[[ -f $lib ]] || die "verify.sh not found (run server/setup.sh)"
# shellcheck source=../lib/verify.sh
source "$lib"

CONF=${SAFESPACE_SERVER_CONF:-/etc/safespace/server.conf}
[[ -f $CONF ]] || die "no $CONF (run server/setup.sh)"
# Sourced, so it must not be writable by anyone but its owner (root, or the
# user running a test setup).
owner=$(stat -c %u "$CONF")
[[ ($owner == 0 || $owner == "$EUID") && -z $(find "$CONF" -perm /022) ]] ||
	die "$CONF must be owned by root and writable by its owner only"
# shellcheck source=server.conf.example
source "$CONF"
SHARE=${SHARE:-/srv/safespace/share}
STATE=${STATE:-/var/lib/safespace/state}
DB_CERT=${DB_CERT:-/etc/safespace/db.pem}
SERVICE_USER=${SERVICE_USER:-safespace}

CMD=${1:-}
[[ -n $CMD ]] || { usage >&2; exit 1; }
shift

# Checks write their results as the service user (root only for dnsmasq-config).
if [[ $EUID -eq 0 && $CMD == verify ]] && id "$SERVICE_USER" >/dev/null 2>&1; then
	exec runuser -u "$SERVICE_USER" -- "$SELF" "$CMD" "$@"
fi

# A fingerprint of what is served: release + SHA256SUMS name every file's hash.
fingerprint() { cat "$SHARE/$1/release" "$SHARE/$1/SHA256SUMS" 2>/dev/null | sha256sum | cut -d' ' -f1; }

verify_one() { # VARIANT -> 0 ok, 1 broken
	local variant=$1 tmp fp version out rc=0
	fp=$(fingerprint "$variant")
	version=$(release_get "$SHARE/$variant/release" VERSION 2>/dev/null || true)
	log "checking $variant ${version:-(no release)}"
	tmp=$(mktemp -d -t safespace-verify.XXXXXX)
	out=$(verify_release "$SHARE/$variant" "$variant" "$DB_CERT" "$tmp" 2>&1) || rc=1
	rm -rf "$tmp"
	printf '%s\n' "$out" | sed 's/^/  /'
	{
		echo "VERSION=${version:-}"
		echo "BUILD=$(release_get "$SHARE/$variant/release" BUILD 2>/dev/null || true)"
		echo "GROUPS=$(release_get "$SHARE/$variant/release" GROUPS 2>/dev/null || true)"
		echo "CHECKED=$(date -Is)"
		echo "FINGERPRINT=$fp"
		if ((rc == 0)); then
			echo "RESULT=ok"
		else
			echo "RESULT=BROKEN"
			echo "REASON=$(printf '%s\n' "$out" | grep -v '^    ' | tail -1)"
		fi
	} >"$STATE/$variant.new"
	mv "$STATE/$variant.new" "$STATE/$variant"
	if ((rc == 0)); then
		log "$variant $version: ok"
	else
		log "$variant ${version:-}: BROKEN — machines will refuse it; release it again from the build host"
	fi
	return $rc
}

verify() {
	local changed=0 variants=() v rc=0
	while (($#)); do
		case $1 in
			--changed) changed=1; shift ;;
			network | usb) variants+=("$1"); shift ;;
			*) die "verify: unknown argument $1" ;;
		esac
	done
	((${#variants[@]})) || variants=(network usb)
	mkdir -p "$STATE"
	exec 9>"$STATE/.lock"
	flock 9
	for v in "${variants[@]}"; do
		[[ -f $SHARE/$v/release ]] || { ((changed)) || log "$v: nothing served"; continue; }
		if ((changed)) && [[ -f $STATE/$v ]] &&
			[[ $(release_get "$STATE/$v" FINGERPRINT) == "$(fingerprint "$v")" ]]; then
			continue
		fi
		verify_one "$v" || rc=1
	done
	return $rc
}

status() {
	local v
	for v in network usb; do
		if [[ ! -f $SHARE/$v/release ]]; then
			printf '%-8s nothing served\n' "$v"
			continue
		fi
		r=$SHARE/$v/release
		printf '%-8s %s, served since %s\n' "$v" "$(release_get "$r" BUILD || true)" "$(date -r "$r" '+%F %T')"
		printf '         groups %s, built %s, snapshot %s, commit %s, %s packages\n' "$(release_get "$r" GROUPS)" \
			"$(release_get "$r" BUILT)" "$(release_get "$r" SNAPSHOT)" "$(release_get "$r" COMMIT)" "$(release_get "$r" PACKAGES)"
		if [[ ! -f $STATE/$v ]]; then
			printf '         not checked yet (safespace-netboot verify %s)\n' "$v"
		elif [[ $(release_get "$STATE/$v" FINGERPRINT) != "$(fingerprint "$v")" ]]; then
			printf '         changed since the last check (%s)\n' "$(release_get "$STATE/$v" CHECKED)"
		else
			printf '         %s, checked %s %s\n' "$(release_get "$STATE/$v" RESULT)" "$(release_get "$STATE/$v" CHECKED)" \
				"$(release_get "$STATE/$v" REASON)"
		fi
	done
}

# dnsmasq for DHCP_MODE: proxy (PXE boot answers next to the LAN's own DHCP
# server, TFTP) or dhcp (this server is the DHCP server: UEFI HTTP boot with
# options 60/67, PXE/TFTP as fallback). Runs as root (ExecStartPre).
dnsmasq_config() {
	local out=${RUNTIME_DIRECTORY:-/run/safespace-dhcp}/dnsmasq.conf url
	[[ ${DHCP_MODE:-off} == proxy || ${DHCP_MODE:-off} == dhcp ]] ||
		die "DHCP_MODE=${DHCP_MODE:-off}: nothing to configure (proxy or dhcp)"
	[[ ${DHCP_INTERFACE:-} =~ ^[A-Za-z0-9._-]+$ ]] || die "DHCP_INTERFACE= missing or invalid"
	url=${SERVER_URL%/}/network/boot.efi
	[[ $url =~ ^https?://[^/[:space:]]+/[^[:space:]]*$ ]] || die "SERVER_URL= missing or invalid"
	mkdir -p "$(dirname "$out")"
	{
		echo "# generated by safespace-netboot dnsmasq-config from $CONF; edits are overwritten"
		echo "interface=$DHCP_INTERFACE"
		echo "bind-interfaces"
		echo "port=0"
		echo "dhcp-match=set:efi64,option:client-arch,7"
		echo "dhcp-match=set:efi64,option:client-arch,9"
		if [[ $DHCP_MODE == proxy ]]; then
			[[ ${DHCP_PROXY_SUBNET:-} =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "DHCP_PROXY_SUBNET= missing or invalid"
			echo "dhcp-range=$DHCP_PROXY_SUBNET,proxy"
			echo "pxe-service=tag:efi64,x86-64_EFI,\"safespace netboot\",network/boot.efi"
		else
			[[ ${DHCP_RANGE:-} =~ ^[0-9.]+,[0-9.]+(,[0-9]+[smhd]?)?$ ]] || die "DHCP_RANGE= missing or invalid"
			echo "dhcp-range=$DHCP_RANGE"
			[[ -z ${DHCP_ROUTER:-} ]] || echo "dhcp-option=option:router,$DHCP_ROUTER"
			[[ -z ${DHCP_DNS:-} ]] || echo "dhcp-option=option:dns-server,$DHCP_DNS"
			echo "dhcp-vendorclass=set:httpclient,HTTPClient:Arch:00016"
			echo "dhcp-match=set:httpclient,option:client-arch,16"
			echo "dhcp-option-force=tag:httpclient,60,HTTPClient"
			echo "dhcp-boot=tag:httpclient,$url"
			echo "dhcp-boot=tag:efi64,network/boot.efi"
		fi
		echo "enable-tftp"
		echo "tftp-root=$SHARE"
		echo "tftp-single-port"
		echo "log-dhcp"
		[[ -d /etc/safespace/dnsmasq.d ]] && echo "conf-dir=/etc/safespace/dnsmasq.d/,*.conf"
	} >"$out"
	log "wrote $out (DHCP_MODE=$DHCP_MODE, boot file network/boot.efi)"
}

case $CMD in
	verify) verify "$@" ;;
	status) status ;;
	dnsmasq-config) dnsmasq_config ;;
	-h | --help) usage ;;
	*) usage >&2; die "unknown command $CMD" ;;
esac
