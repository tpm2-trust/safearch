# Build outputs (mkosi.output/) and, from builds without OutputDirectory=,
# outputs in the project root.
mkosi.output/
/initrd
/initrd.cpio.zst
/*.raw
/*.raw.zst
/*.efi
/*.roothash
/*.manifest
/*.vnc-password
/safespace-arch-*

# Releases staged by release.sh (a local copy of what is pushed).
mkosi.release/

# Caches and mkosi's generated keys/tools.
mkosi.cache/
mkosi.pkgcache/
mkosi.tools/
mkosi.workspace/
mkosi.key
mkosi.crt

# Per-host and per-user settings.
safespace.local.conf
mkosi.local.conf
users.conf
server/server.conf

# Generated into the image tree by fetch-images.sh and secureboot-export.sh.
mkosi.profiles/docker/mkosi.extra/usr/share/safespace/docker-images/
mkosi.extra/usr/share/safespace/secureboot/
# Built by build.sh from the submodule assh/ (lib/assh.sh).
mkosi.extra/usr/bin/assh
mkosi.initrd.conf/mkosi.extra/usr/bin/assh
# Generated by build.sh from safespace.conf (lib/settings.sh), for the root and
# the initrd.
mkosi.extra/etc/assh/
mkosi.initrd.conf/mkosi.extra/etc/assh/
mkosi.extra/usr/local/lib/safespace/settings
mkosi.initrd.conf/mkosi.extra/usr/local/lib/safespace/settings

# Test builds, VM disks, hwtest-image.sh output.
mkosi.test/

# Not part of this repository: a separate checkout lives here locally.
/tpm2-kira/
