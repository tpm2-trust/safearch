# The machine's identity: made at the first sealed boot, released in its
# combination (/usr/local/lib/safespace/identity). After the combination is
# chosen and measured (safespace-select.service), while PCR 11 still holds
# enter-initrd (systemd-pcrphase-initrd measures leave-initrd when it stops,
# after this); before the network (network-pre.target: systemd-networkd, netroot),
# so the initrd's DHCP asks with the machine's machine-id, as the running system
# does. Nothing of it comes from the network. Without a TPM or an identity it only
# logs; it fails only when PCR 15 cannot be closed by any way of aSSH's ladder, and
# then the machine reboots at once, as systemd's own measuring units do: no network, no root and no
# shell with the machine-id open to unseal. A TPM that keeps failing keeps it rebooting.
[Unit]
Description=Make or release the machine's identity (its combination only)
DefaultDependencies=no
After=safespace-select.service tpm2.target systemd-pcrphase-initrd.service systemd-tpm2-setup-early.service
Wants=network-pre.target
Before=network-pre.target
Before=initrd.target initrd-switch-root.target
Conflicts=shutdown.target
FailureAction=reboot-force

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120s
ExecStart=/usr/local/lib/safespace/identity
