# Enabled by the initrd.target.wants symlink next to this file, not by an
# [Install] section: the default initrd applies presets with "disable *".
# The boot path over the network: the firmware loaded the UKI itself, so there
# is no LoaderDevicePartUUID (from a stick systemd-boot sets it, and
# usb-bootdev.service runs instead).
[Unit]
Description=Fetch and verify the root image over the network
DefaultDependencies=no
ConditionKernelCommandLine=safespace.netroot
ConditionPathExists=!/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
# systemd-networkd does the DHCP (20-netboot.network), udev loads the NIC
# drivers from the kernel modules initrd.
# The combination chosen before (safespace-select.service); the machine-id
# released before the network (safespace-identity.service, before
# network-pre.target), so DHCP asks as the machine, as the running system does.
Requires=systemd-networkd.service safespace-select.service
After=systemd-networkd.service safespace-select.service safespace-identity.service systemd-udevd.service systemd-udev-trigger.service
Wants=systemd-udev-trigger.service
# It mounts the chosen combination's layers at /sysroot itself (no root=):
# before the root file system counts as there.
Before=initrd-root-device.target cryptsetup-pre.target veritysetup-pre.target sysroot.mount
Before=initrd-root-fs.target systemd-volatile-root.service initrd-parse-etc.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Must cover the download of the whole root image (a few hundred MiB to a few
# GiB); the script's own curl timeout (MAX_TIME) is the real limit.
TimeoutStartSec=1200s
ExecStart=/usr/local/lib/safespace/netroot
