# The chosen combination's layers, opened and stacked (POSIX sh, initrd),
# sourced by usb-bootdev and netroot after select (SELECT_LAYERS, bottom first;
# select_layer_hash). Expects msg().
#
#   stack_open LAYER DATA HASH   dm-verity: DATA against LAYER's root hash from the
#                                signed command line, as /dev/mapper/layer-<LAYER>,
#                                --panic-on-corruption (a modified or damaged
#                                block stops the machine)
#   stack_mount                  the layers at /sysroot, read-only: one layer is
#                                its erofs; more are overlayfs without an upper
#                                layer (settings' SAFESPACE_OVERLAY, as the build
#                                proved the stack), the top first
#
# Before initrd-root-fs.target (the units): there is no root= (lib/compose.sh),
# the stack is the root. SAFESPACE_SYSROOT, SAFESPACE_VERITYSETUP,
# SAFESPACE_MOUNT, SAFESPACE_DEV: only for tests/run.sh.

STACK_SYSROOT=${SAFESPACE_SYSROOT:-/sysroot}
STACK_DEV=${SAFESPACE_DEV:-/dev/mapper}
STACK_VERITYSETUP=${SAFESPACE_VERITYSETUP:-veritysetup}
STACK_MOUNT=${SAFESPACE_MOUNT:-mount}

stack_open() { # LAYER DATA HASH
	h=$(select_layer_hash "$1")
	[ -n "$h" ] || { msg "ERROR: no root hash for layer $1 on the signed command line"; return 1; }
	# The root hash comes from the signed command line: this is the step that
	# decides whether the image is the one that was signed.
	if ! out=$("$STACK_VERITYSETUP" open "$2" "layer-$1" "$3" "$h" --panic-on-corruption 2>&1); then
		msg "ERROR: dm-verity refused layer $1: $out"
		return 1
	fi
	msg "layer $1 opened as $STACK_DEV/layer-$1, verified against $(printf %.12s "$h")..."
}

stack_mount() {
	modprobe -a erofs overlay 2>/dev/null
	# No sysroot.mount creates it: there is no root= on the command line.
	mkdir -p "$STACK_SYSROOT"
	set -- $SELECT_LAYERS
	if [ $# -eq 1 ]; then
		out=$("$STACK_MOUNT" -t erofs -o ro "$STACK_DEV/layer-$1" "$STACK_SYSROOT" 2>&1) ||
			{ msg "ERROR: cannot mount layer $1 at $STACK_SYSROOT: $out"; return 1; }
		msg "root: layer $1 (erofs, read-only)"
		return 0
	fi
	lower=""
	for l in "$@"; do
		mkdir -p "$SELECT_RUN/layers/$l" &&
			out=$("$STACK_MOUNT" -t erofs -o ro "$STACK_DEV/layer-$l" "$SELECT_RUN/layers/$l" 2>&1) ||
			{ msg "ERROR: cannot mount layer $l: $out"; return 1; }
		lower=$SELECT_RUN/layers/$l${lower:+:$lower}
	done
	out=$("$STACK_MOUNT" -t overlay overlay -o "$SAFESPACE_OVERLAY,lowerdir=$lower" "$STACK_SYSROOT" 2>&1) ||
		{ msg "ERROR: cannot stack the layers $SELECT_LAYERS at $STACK_SYSROOT: $out"; return 1; }
	msg "root: layers $SELECT_LAYERS stacked read-only (overlayfs, $SAFESPACE_OVERLAY)"
}
