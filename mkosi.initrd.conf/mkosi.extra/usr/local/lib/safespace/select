# Which root to open (POSIX sh, initrd), sourced: choose (safespace-select.service)
# decides it once with select_root; usb-bootdev and netroot take it with
# select_chosen; identity reads the names below. Expects $cmdline and msg().
# Both set SELECT_NAME and SELECT_HASH (the root hash to open), or return 1
# with a message.
#
# The build names every combination on the signed command line:
# safespace.root.<name>=<root hash>. The choice, first match:
#   1. safespace.select=<name> on the command line (a boot menu entry)
#   2. EFI variable SafespaceSelectOnce-<GUID>: for this boot only, deleted here
#   3. EFI variable SafespaceSelect-<GUID>: the persistent preselection
#   4. the first combination on the command line (combinations.conf's first)
# (set with safespace select on the running system). The variables only name a
# combination; its root hash always comes from the signed command line, so a
# changed variable can select another signed root, never an unsigned one. An
# unknown name stops the boot: a wrong preselection must not go unnoticed.
# Without any safespace.root.* there is nothing to open: the boot stops too
# (roothash= is never used, so no other root hash can come into play).
#
# The decided name is measured into PCR 15 ("safespace-combination:<name>")
# before it is used, and recorded in /run/safespace/combination: the machine's
# identity is sealed to the measurement of its assigned combination (identity,
# next to this file; SECURITY.md, "Machine identity"). The initrd is part of the
# signed UKI (PCR 11), so the code that measures is itself measured, and a PCR
# only extends: nothing later in this boot can turn another selection into the
# assigned one. No TPM, or the extend fails: the boot goes on, nothing unseals.
#
# The names, the GUID, the PCR: settings, next to this file (generated by
# build.sh from safespace.conf, lib/settings.sh), shared with identity and the root.
# SAFESPACE_SETTINGS, SAFESPACE_EFIVARS, SAFESPACE_RUN, SAFESPACE_PCREXTEND: only for
# tests/run.sh (the settings, the efivarfs directory, /run/safespace, the measuring
# program).

. "${SAFESPACE_SETTINGS:-${0%/*}/settings}"
SELECT_VARS=${SAFESPACE_EFIVARS:-/sys/firmware/efi/efivars}
SELECT_RUN=${SAFESPACE_RUN:-/run/safespace}
SELECT_PCREXTEND=${SAFESPACE_PCREXTEND:-/usr/lib/systemd/systemd-pcrextend}

select_arg() { printf '%s\n' "$cmdline" | tr ' ' '\n' | sed -n "s/^$1=//p" | tail -n 1; }

# A selection variable's value: 4 bytes of attributes, then the name.
select_var() { # NAME
	f=$SELECT_VARS/$1-$SAFESPACE_GUID
	[ -r "$f" ] || return 0
	v=$(tail -c +5 "$f" | tr -d '\000\n')
	case $v in
		'' | *[!a-z0-9-]*) msg "ignoring $1: not a combination name"; return 0 ;;
	esac
	printf '%s' "$v"
}

select_root() {
	SELECT_NAME="" SELECT_HASH=""
	names=$(printf '%s\n' "$cmdline" | tr ' ' '\n' | sed -n 's/^safespace\.root\.\([a-z][a-z0-9-]*\)=[0-9a-f]\{64\}$/\1/p' | tr '\n' ' ')
	if [ -z "$names" ]; then
		msg "ERROR: no safespace.root.<name>= on the signed command line"
		return 1
	fi
	want=$(select_arg safespace.select) from="the command line"
	if [ -z "$want" ]; then
		want=$(select_var $SAFESPACE_SELECT_ONCE_VAR) from="$SAFESPACE_SELECT_ONCE_VAR (this boot only)"
		# Once means once: delete it before anything else can fail. (efivarfs
		# makes variables of unknown vendors immutable: chattr -i first.)
		if [ -n "$want" ]; then
			f=$SELECT_VARS/$SAFESPACE_SELECT_ONCE_VAR-$SAFESPACE_GUID
			chattr -i "$f" 2>/dev/null
			rm -f "$f" || msg "WARNING: could not delete $SAFESPACE_SELECT_ONCE_VAR"
		fi
	fi
	[ -n "$want" ] || { want=$(select_var $SAFESPACE_SELECT_VAR) from=$SAFESPACE_SELECT_VAR; }
	[ -n "$want" ] || { want=${names%% *} from="no selection: the first"; }
	case $want in
		*[!a-z0-9-]*) msg "ERROR: invalid combination name '$want' ($from)"; return 1 ;;
	esac
	SELECT_HASH=$(select_arg "safespace.root.$want")
	if [ -z "$SELECT_HASH" ]; then
		msg "ERROR: combination '$want' ($from) is not in this build (it has: $names)"
		return 1
	fi
	SELECT_NAME=$want
	msg "combination $want ($from), roothash=$(printf %.12s "$SELECT_HASH")..."
	select_measure "$want"
}

# The combination choose decided and measured this boot, its root hash from the
# signed command line.
select_chosen() {
	SELECT_NAME=$(cat "$SELECT_RUN/combination" 2>/dev/null) SELECT_HASH=""
	case $SELECT_NAME in
		'' | *[!a-z0-9-]*) msg "ERROR: no combination chosen this boot (safespace-select.service)"; return 1 ;;
	esac
	SELECT_HASH=$(select_arg "safespace.root.$SELECT_NAME")
	[ -n "$SELECT_HASH" ] || { msg "ERROR: combination '$SELECT_NAME' is not in this build"; return 1; }
}

# Exactly once per boot: a second measurement no longer matches the sealed value.
select_measure() { # NAME
	if [ -e "$SELECT_RUN/combination" ]; then
		msg "WARNING: the selection was measured already this boot, not again"
		return 0
	fi
	mkdir -p "$SELECT_RUN" && printf '%s\n' "$1" >"$SELECT_RUN/combination" ||
		{ msg "WARNING: cannot record the selection"; return 0; }
	"$SELECT_PCREXTEND" --graceful --pcr=$SAFESPACE_PCR "$SAFESPACE_COMBINATION_EVENT$1" >/dev/null 2>&1 ||
		msg "WARNING: could not measure the selection (no machine identity this boot)"
}
