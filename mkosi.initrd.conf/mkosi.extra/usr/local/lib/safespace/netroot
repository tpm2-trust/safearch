#!/bin/sh
# Runs in the initrd of a network boot (bash as sh, coreutils,
# sed, kmod, curl, veritysetup), started by netroot.service. It downloads the
# chosen combination's layers - each an image and its dm-verity hash tree - into
# a tmpfs, opens each against its signed root hash and stacks them read-only at
# /sysroot (stack, next to this script): there is no root= on the command line.
#
# Everything it trusts comes from the kernel command line inside the signed
# UKI, nothing from the network:
#   safespace.netroot=<url>/  base URL of a distribution server, may be given
#                             more than once (tried in order)
#   safespace.layer.<layer>=<hash>  dm-verity root hash per layer
#   safespace.root.<name>=<layer>,...  a combination's layers, bottom first; the
#                             combination is chosen before (safespace-select.service)
# veritysetup refuses a hash tree that does not match that hash, and dm-verity
# then checks every block that is read, with --panic-on-corruption. A
# manipulated or wrong server can therefore only keep the machine from
# booting, never change what boots. Plain HTTP is enough for that; HTTPS only
# adds confidentiality (and needs a certificate curl trusts).
#
# Files expected under each URL (one release, written by release.sh), of the
# chosen combination's layers only:
#   roothash-<layer>      its root hash
#   root-<layer>.img      its erofs image (dm-verity data)
#   root-<layer>.verity   its dm-verity hash tree
# A server only ever holds the newest release. If no server has this UKI's
# release any more (a layer with another roothash), a newer one was published
# after the firmware loaded this UKI: reboot, and the firmware loads the new
# boot.efi.
#
# Progress goes to the kernel log (so `journalctl -b -g netroot` has it after
# boot) and to /dev/console, because the kernel log at info level does not
# reach the screen once systemd has taken over the console -- and a netboot
# that stalls is watched on the screen.

WAIT_ONLINE=60          # seconds to wait for a DHCP address
MAX_TIME=900            # seconds for one download
# tmpfs for the images; stays mounted after switch-root. NETROOT_DIR and
# NETROOT_CMDLINE only exist for tests/run.sh (netroot.service sets neither).
DIR=${NETROOT_DIR:-/run/netroot}

msg() {
	echo "netroot: $*" >/dev/kmsg 2>/dev/null
	echo "netroot: $*" >/dev/console 2>/dev/null
	return 0
}
die() { msg "ERROR: $*"; exit 1; }

cmdline=${NETROOT_CMDLINE:-$(cat /proc/cmdline)}
args() { printf '%s\n' "$cmdline" | tr ' ' '\n' | sed -n "s/^$1=//p"; }

urls=$(args safespace.netroot)
[ -n "$urls" ] || { msg "no safespace.netroot= on the kernel command line, nothing to do"; exit 0; }
# Which layers: the chosen combination's.
. "${0%/*}/select"
. "${0%/*}/stack"
select_chosen || die "no root to boot"
LAYERS=$SELECT_LAYERS

modprobe -a loop dm-verity erofs 2>/dev/null

# --- network ----------------------------------------------------------------
# systemd-networkd is started by netroot.service and configures DHCP on every
# physical ethernet port (20-netboot.network next to this script).
msg "waiting up to ${WAIT_ONLINE}s for a DHCP address"
if /usr/lib/systemd/systemd-networkd-wait-online --any --timeout="$WAIT_ONLINE"; then
	msg "link up: $(ip -o -4 addr show scope global 2>/dev/null | tr -s ' ' | cut -d' ' -f2,4 | tr '\n' ' ')"
	# DHCP's client identifier comes from the machine-id (systemd-networkd, started
	# after safespace-identity): the machine's where that released it, as the
	# running system asks.
	if [ -s "$SELECT_RUN/identity/machine-id" ] && [ "$(cat /etc/machine-id 2>/dev/null)" = "$(cat "$SELECT_RUN/identity/machine-id")" ]; then
		msg "DHCP as the machine (its machine-id, released before the network)"
	else
		msg "DHCP with a temporary machine-id (no identity released this boot)"
	fi
else
	msg "no link reported as online, trying anyway"
fi
# A host name in the URL needs no setup here: the initrd resolves it through
# nss-resolve, which systemd-networkd answers over its resolve-hook socket
# (enabled in mkosi's initrd) using the DNS servers from the DHCP lease. There
# is no systemd-resolved in the initrd and no /etc/resolv.conf to write. If the
# DHCP answer carries no usable DNS server, curl below says "Could not resolve
# host" -- an IP address in the URL avoids the question entirely.

# --- download and open ------------------------------------------------------

size_of() { # url -> Content-Length of a 200 answer, or empty
	# A HEAD request also prints the headers of an error page, so check the
	# status code (curl appends it) before taking a Content-Length from it.
	hdr=$(curl -sIL --max-time 30 -w 'status=%{http_code}' "$1" 2>/dev/null | tr -d '\r')
	case $hdr in
		*status=200) ;;
		*) return 0 ;;
	esac
	printf '%s\n' "$hdr" |
		sed -n 's/^[Cc]ontent-[Ll]ength:[[:space:]]*\([0-9][0-9]*\).*$/\1/p' | tail -n 1
}

get() { # url file
	start=$(date +%s)
	if ! out=$(curl -fsS --retry 3 --retry-delay 2 --max-time "$MAX_TIME" -o "$2" "$1" 2>&1); then
		msg "download of $1 failed: $out"
		return 1
	fi
	bytes=$(stat -c %s "$2")
	secs=$(($(date +%s) - start))
	[ "$secs" -gt 0 ] || secs=1
	msg "got ${1##*/}: $((bytes / 1048576)) MiB in ${secs}s ($((bytes / 1048576 / secs)) MiB/s)"
}

cleanup() {
	for l in $LAYERS; do
		umount "$SELECT_RUN/layers/$l" 2>/dev/null
		veritysetup close "layer-$l" 2>/dev/null
	done
	for d in $loops; do losetup -d "$d" 2>/dev/null; done
	umount "$DIR" 2>/dev/null
	loops=""
}

# The release this server holds: 0 = this UKI's (every layer's roothash the
# signed one), 1 = another one (newer), 2 = unknown (no roothash served, or not
# reachable).
served_release() { # base url
	for l in $LAYERS; do
		served=$(curl -fsS --retry 2 --max-time 20 "$1/roothash-$l" 2>/dev/null | tr -d '[:space:]')
		[ -n "$served" ] || return 2
		[ "$served" = "$(select_layer_hash "$l")" ] || return 1
	done
	return 0
}

loops="" other=0 same=0
try() { # base url (without trailing slash)
	base=$1
	tmpfs_size="" tmpfs_size_opt=""
	served_release "$base"
	case $? in
		1) msg "$base holds another release (roothash-$l $(printf %.12s "$served")..., this UKI: $(printf %.12s "$(select_layer_hash "$l")")...)"
			other=1
			return 1 ;;
		2) msg "$base serves no roothash, trying the images anyway" ;;
		*) same=1 ;;
	esac
	msg "fetching layers $LAYERS from $base"

	# Reserve RAM for every image before downloading: the layers stay in this
	# tmpfs for as long as the machine runs, because they *are* the root
	# filesystem (erofs, decompressed on read).
	total=0 sizes=yes
	for l in $LAYERS; do
		isize=$(size_of "$base/root-$l.img")
		vsize=$(size_of "$base/root-$l.verity")
		if [ -n "$isize" ] && [ -n "$vsize" ]; then
			msg "root-$l.img $((isize / 1048576)) MiB + root-$l.verity $((vsize / 1048576)) MiB"
			total=$((total + isize + vsize))
		else
			sizes=no
		fi
	done
	if [ $sizes = yes ]; then
		need_kb=$((total / 1024 + 262144))
		avail_kb=$(sed -n 's/^MemAvailable:[[:space:]]*\([0-9][0-9]*\) kB$/\1/p' /proc/meminfo)
		[ -n "$avail_kb" ] || avail_kb=0
		msg "$((total / 1048576)) MiB for the layers, $((avail_kb / 1024)) MiB RAM free"
		if [ "$avail_kb" -gt 0 ] && [ "$avail_kb" -lt "$need_kb" ]; then
			msg "not enough RAM: need $((need_kb / 1024)) MiB free, have $((avail_kb / 1024)) MiB"
			return 1
		fi
		tmpfs_size=$((total + 16777216))
	else
		msg "server does not report sizes (no Content-Length), using 90% of RAM for the images"
		tmpfs_size_opt=90%
	fi

	mkdir -p "$DIR"
	mount -t tmpfs -o "size=${tmpfs_size:-${tmpfs_size_opt}},mode=0700" netroot "$DIR" ||
		{ msg "cannot mount the tmpfs for the images"; return 1; }

	for l in $LAYERS; do
		get "$base/root-$l.verity" "$DIR/root-$l.verity" || return 1
		get "$base/root-$l.img" "$DIR/root-$l.img" || return 1
		data=$(losetup -f --show -r "$DIR/root-$l.img") || { msg "losetup for root-$l.img failed"; return 1; }
		loops="$loops $data"
		hash=$(losetup -f --show -r "$DIR/root-$l.verity") || { msg "losetup for root-$l.verity failed"; return 1; }
		loops="$loops $hash"
		if ! stack_open "$l" "$data" "$hash"; then
			# Replaced while downloading?
			served_release "$base"
			[ $? -eq 1 ] && { msg "$base published another release meanwhile"; other=1; }
			return 1
		fi
	done
	# systemd and udev settle the devices before they are mounted.
	udevadm settle -t 15
	stack_mount || return 1
}

for url in $urls; do
	case $url in
		http://* | https://*) ;;
		*) msg "ignoring safespace.netroot=$url: not an http(s) URL"; continue ;;
	esac
	# Accept the URL with or without a trailing slash.
	if try "${url%/}"; then
		exit 0
	fi
	cleanup
done

# Reboot only if no server holds this UKI's release any more: a server that
# has it but failed otherwise is an error, not a newer release.
if [ "$other" -eq 1 ] && [ "$same" -eq 0 ]; then
	msg "this UKI's release is no longer served: a newer one was published after the firmware loaded it. Rebooting in 10 s to load the new one."
	sleep 10
	systemctl reboot
	exit 1
fi
die "no server provided a usable root image, tried: $(echo "$urls" | tr '\n' ' ')"
