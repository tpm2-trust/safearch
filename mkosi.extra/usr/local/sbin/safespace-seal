#!/usr/bin/env bash
# Seal this machine: enroll the Secure Boot keys this stick is signed with.
# The machine must be in Setup Mode (firmware setup: "Reset to Setup Mode" /
# "Clear Secure Boot keys"). Afterwards the firmware only boots EFI binaries
# signed by these keys (plus whatever stays in db, see --replace).
#
#   sudo safespace-seal [--replace] [--yes]
#
# Default: add our KEK and db to what the firmware still has, then set our PK.
#   Keeps vendor/Microsoft certificates if present, so GPU/NIC option ROMs and
#   firmware tools keep working.
# --replace: db and KEK contain ONLY our keys. Option ROMs signed by Microsoft
#   (many GPUs, NICs, storage controllers) will no longer load: no display in
#   firmware setup or a machine that does not boot at all. Only use on machines
#   known to have no such devices (e.g. integrated graphics only).
# Finally switch Secure Boot on in the firmware setup if it does not turn on by
# itself, and set a firmware password.
#
#   sudo safespace-seal --assign NAME [--yes]
#   safespace-seal --identity
#
# The machine's identity (SECURITY.md, "Machine identity"): on the first boot
# with Secure Boot on, the initrd creates an ssh host key and machine-id and
# seals them to this TPM, to Secure Boot with these keys and to the combination
# that booted. From then on they are released whenever that combination boots,
# also after updates; any other combination gets a throwaway host key and
# machine-id.
# --assign NAME: move this machine to the combination NAME: at the next boot,
#   which boots NAME, the initrd replaces the identity with a new one (a new
#   host key: ssh clients will notice). Needs Secure Boot on, with this stick's PK.
# --identity: this boot's identity: combination, released or not, the host
#   key's fingerprint and known_hosts line, the machine's inventory ID.
set -Eeuo pipefail

KEYS=/usr/share/safespace/secureboot
EFIVARS=/sys/firmware/efi/efivars
GLOBAL=8be4df61-93ca-11d2-aa0d-00e098032b8c
IMGSEC=d719b2cb-3d3a-4596-a3bc-dad00e67656f

die() { printf '\e[1;31m==> ERROR:\e[0m %s\n' "$*" >&2; exit 1; }
log() { printf '\e[1;32m==>\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m==> WARNING:\e[0m %s\n' "$*" >&2; }

REPLACE=0 CONFIRM=1 ASSIGN="" IDENTITY=0
while (($#)); do
	case $1 in
		--replace) REPLACE=1; shift ;;
		--yes) CONFIRM=0; shift ;;
		--assign) ASSIGN=${2:-}; shift 2 || die "--assign needs a combination name" ;;
		--identity) IDENTITY=1; shift ;;
		-h|--help) sed -n '2,${/^#/!q;s/^# \?//;p}' "$0"; exit 0 ;;
		*) die "unknown option $1" ;;
	esac
done

# The selection variables' vendor GUID (safespace-select, the initrd's select).
SELECT_GUID=8a3e6c1d-4b2f-4e9a-b7d5-1c0f9e2a6b34
# The machine's inventory ID: its machine-id, hashed for this application
# (machine-id(5): the machine-id itself stays confidential).
APP_ID=eda1fc8c35e94e2087addff88d0b4e91

if ((IDENTITY)); then
	booted=$(cat /usr/lib/safespace/combination 2>/dev/null || echo "?")
	echo "combination:   $booted"
	for v in SafespaceIdHostKey SafespaceIdMachine; do
		[[ -e $EFIVARS/$v-$SELECT_GUID ]] && st="sealed in the firmware" || st="none (not assigned)"
		printf '%-14s %s\n' "${v#SafespaceId}:" "$st"
	done
	# Written by the initrd (identity): the slots it released this boot.
	if grep -qx SafespaceIdHostKey /run/safespace/identity/released 2>/dev/null; then
		echo "this boot:     identity released (this is the machine's assigned combination)"
		echo "inventory ID:  $(systemd-id128 machine-id --app-specific=$APP_ID)"
	else
		echo "this boot:     no identity (throwaway host key and machine-id)"
	fi
	k=/var/lib/sshd/etc/ssh/ssh_host_ed25519_key.pub
	if [[ -r $k ]]; then
		echo "host key:      $(ssh-keygen -lf "$k" | cut -d' ' -f2)"
		echo "known_hosts:   $(uname -n) $(cut -d' ' -f1,2 "$k")"
	fi
	exit 0
fi

[[ $EUID -eq 0 ]] || die "must run as root"
[[ -d $EFIVARS ]] || die "not booted in UEFI mode"
[[ -f $KEYS/PK.auth ]] || die "this image contains no Secure Boot keys (build it with build.sh, which exports them)"
mountpoint -q "$EFIVARS" || mount -t efivarfs efivarfs "$EFIVARS"
grep -q " $EFIVARS efivarfs rw" /proc/mounts || mount -o remount,rw "$EFIVARS"

# Value byte of a global UEFI variable (after the 4-byte attribute header).
var_byte() { od -An -tu1 -j4 -N1 "$EFIVARS/$1-$GLOBAL" 2>/dev/null | tr -d ' '; }
# Certificate subjects in a signature-database variable.
list_var() { # name guid
	local f=$EFIVARS/$1-$2
	[[ -s $f ]] || { echo "    (empty)"; return; }
	tail -c +5 "$f" >/tmp/.seal-$1.esl
	sig-list-to-certs /tmp/.seal-$1.esl /tmp/.seal-$1 >/dev/null 2>&1 || true
	local found=0 c
	for c in /tmp/.seal-$1-*.der; do
		[[ -e $c ]] || continue
		found=1
		echo "    $(openssl x509 -inform der -in "$c" -noout -subject -nameopt oneline 2>/dev/null | sed 's/^subject=//')"
	done
	((found)) || echo "    (entries without certificate, e.g. hashes)"
	rm -f /tmp/.seal-$1*
}

setup=$(var_byte SetupMode)
sb=$(var_byte SecureBoot)
log "SetupMode=${setup:-?} SecureBoot=${sb:-?}"

if [[ -n $ASSIGN ]]; then
	[[ $ASSIGN =~ ^[a-z][a-z0-9-]{0,23}$ ]] || die "not a combination name: $ASSIGN"
	[[ " $(cat /proc/cmdline) " == *" safespace.root.$ASSIGN="* ]] ||
		die "'$ASSIGN' is not a combination of this build (safespace-select list)"
	[[ $setup == 0 && $sb == 1 ]] ||
		die "Secure Boot is not on (SetupMode=${setup:-?} SecureBoot=${sb:-?}): seal first, switch it on, then assign"
	# The identity is bound to PCR 7, i.e. to the Secure Boot keys in the firmware:
	# they must be this stick's, or the next build would not see the same values.
	tail -c +5 "$EFIVARS/PK-$GLOBAL" >/tmp/.seal-PK.esl
	sig-list-to-certs /tmp/.seal-PK.esl /tmp/.seal-PK >/dev/null 2>&1 || true
	[[ -s /tmp/.seal-PK-0.der && $(sha256sum </tmp/.seal-PK-0.der) == "$(openssl x509 -in "$KEYS/PK.pem" -outform DER | sha256sum)" ]] ||
		{ rm -f /tmp/.seal-PK*; die "the firmware's PK is not this stick's: seal with this stick first"; }
	rm -f /tmp/.seal-PK*
	if [[ -e $EFIVARS/SafespaceIdHostKey-$SELECT_GUID ]]; then
		warn "this machine has an identity already: it is replaced (new host key and machine-id)"
	fi
	if ((CONFIRM)); then
		read -rp "Assign this machine to '$ASSIGN'? Type YES: " answer
		[[ $answer == YES ]] || die "aborted"
	fi
	for v in SafespaceAssign SafespaceSelectOnce; do
		f=$EFIVARS/$v-$SELECT_GUID
		[[ -e $f ]] && { chattr -i "$f" 2>/dev/null || true; rm -f "$f"; }
		printf '\x07\x00\x00\x00%s' "$ASSIGN" >"$f" || die "could not write $v"
	done
	log "Assignment to $ASSIGN requested: reboot now. The initrd boots $ASSIGN once and seals the new identity."
	echo "Then: safespace-seal --identity (fingerprint, inventory ID); safespace-select set $ASSIGN to keep booting it."
	exit 0
fi
[[ $setup == 1 ]] || die "the machine is not in Setup Mode. In the firmware setup choose \"Reset to Setup Mode\" or \"Clear Secure Boot keys\", then boot this stick again."

echo "Currently enrolled:"
for v in PK KEK; do echo "  $v:"; list_var $v $GLOBAL; done
for v in db dbx; do echo "  $v:"; list_var $v $IMGSEC; done
echo "Will enroll (signed by the keys of this stick):"
for k in PK KEK db; do
	printf '  %-4s %s\n' "$k" "$(openssl x509 -in "$KEYS/$k.pem" -noout -subject -nameopt oneline | sed 's/^subject=//')"
done
if ((REPLACE)); then
	warn "--replace: db and KEK will contain ONLY these keys. Devices with option ROMs signed by Microsoft (GPUs, NICs, RAID controllers) will stop working in firmware, which can leave the machine without display or unbootable."
else
	echo "Mode: append (certificates already in KEK/db are kept)"
fi
if ((CONFIRM)); then
	read -rp "Type YES to enroll: " answer
	[[ $answer == YES ]] || die "aborted"
fi

# Existing variables are immutable in efivarfs.
for v in KEK-$GLOBAL db-$IMGSEC PK-$GLOBAL; do
	[[ -e $EFIVARS/$v ]] && chattr -i "$EFIVARS/$v"
done

suffix=-append
((REPLACE)) && suffix=
args=()
((REPLACE)) || args=(-a)
# db and KEK first: writing PK ends Setup Mode, after which only signed
# updates verified against the new PK/KEK are accepted.
log "Enrolling db";  efi-updatevar "${args[@]}" -f "$KEYS/db$suffix.auth" db
log "Enrolling KEK"; efi-updatevar "${args[@]}" -f "$KEYS/KEK$suffix.auth" KEK
log "Enrolling PK";  efi-updatevar -f "$KEYS/PK.auth" PK

setup=$(var_byte SetupMode)
[[ $setup == 0 ]] || die "SetupMode is still ${setup:-?}: the firmware did not accept PK"
log "Sealed. The firmware is in User Mode with this stick's keys."
echo "Next: reboot, make sure Secure Boot is ENABLED in the firmware setup, and set a firmware password."
echo "The first boot with Secure Boot on gives this machine its identity, bound to the combination that boots"
echo "(safespace-select set NAME before rebooting chooses it; safespace-seal --identity shows it)."
