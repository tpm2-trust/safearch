#!/usr/bin/env bash
# Seal this machine: enroll the Secure Boot keys this stick is signed with.
# The machine must be in Setup Mode (firmware setup: "Reset to Setup Mode" /
# "Clear Secure Boot keys"). Afterwards the firmware only boots EFI binaries
# signed by these keys (plus whatever stays in db, see --replace).
#
#   sudo safespace-seal [--replace] [--yes]
#
# Default: add our KEK and db to what the firmware still has, then set our PK.
#   Keeps vendor/Microsoft certificates if present, so GPU/NIC option ROMs and
#   firmware tools keep working.
# --replace: db and KEK contain ONLY our keys. Option ROMs signed by Microsoft
#   (many GPUs, NICs, storage controllers) will no longer load: no display in
#   firmware setup or a machine that does not boot at all. Only use on machines
#   known to have no such devices (e.g. integrated graphics only).
# Finally switch Secure Boot on in the firmware setup if it does not turn on by
# itself, and set a firmware password.
#
#   sudo safespace-seal --identity-create [--pin-fd N] [--lockout-auth-fd N]
#   safespace-seal --identity
#   sudo safespace-seal --approve [--pin-fd N]
#   sudo safespace-seal --move [NAME] [--pin-fd N] [--yes]
#   sudo safespace-seal --identity-clear [--yes]
#   sudo safespace-seal --sha1 on|off
#
# The machine's identity (SECURITY.md, "Machine identity"): its ssh host key is
# aSSH's (assh-agent.service, /etc/assh/assh.conf): made in the TPM at every
# boot and certified by the machine's CA, a key in the TPM whose file is the
# EFI variable SAFEasshCA, only while the PCRs hold a state approved with the
# PIN - the combination (PCR 15) included, so updates keep the identity and
# another combination gets aSSH's temporary key (made in the TPM, not
# certified). The machine-id: sealed in the initrd to the combination too
# (the first boot with Secure Boot on creates it). Clients trust the CA once:
# '@cert-authority <names> <key>' in known_hosts (--identity prints it).
# --identity-create: the first identity, in the combination booted (Secure Boot
#   on, this stick's keys): sets the TPM's lockout authorization if it has none
#   (asked twice; it resets a PIN lockout and clears the TPM: keep it off the
#   machine), asks a new PIN (twice), creates the CA and approves the state
#   this boot's agent recorded. sshd serves the temporary key until the
#   reboot; the next boot certifies.
# --identity: the combination, the machine-id, the CA, its approvals and the
#   known_hosts line, the host key of this boot (certified through which slot,
#   or temporary).
# --approve: after an update this boot was certified through slot 1 (the
#   firmware, an option ROM or the UKI changed): approves this state in every
#   slot (PIN). Only in a boot that was certified: another combination needs
#   --move.
# --move NAME: moves the identity to the combination NAME from this boot, without
#   booting NAME first: approves NAME's state - this boot's PCR 0, 2, 7, 11 (one
#   UKI for every combination) and PCR 15 as NAME's initrd leaves it - with a new
#   generation of the PIN's counter (PIN), which revokes every approval made
#   before; NAME gets the machine-id at its next boot (this one, where it is
#   released here) and is selected. The next boot is NAME's, certified.
# --move: moves the identity to the combination booted (after safespace-select
#   and a reboot: the temporary key), or keeps it here after a Secure Boot
#   change (PCR 7: no slot met): approves this boot's state with a new
#   generation (PIN); this combination gets a new machine-id at the next boot
#   (the machine's is not released here) and keeps booting.
# --identity-clear: removes the identity: the CA (SAFEasshCA), its PIN index and
#   counter in the TPM, the machine-id slot and a pending assignment. The TPM's
#   lockout authorization and --sha1 stay. Clients that trust the CA refuse
#   this machine from then on; --identity-create makes a new one.
# --sha1 on|off: allows SHA-1 on this TPM, or forbids it again: an NV index in
#   the TPM (aSSH's 0x01802914, not signed). It counts only on a TPM whose
#   firmware activates no SHA-256 PCR bank (ThinkPad T450s); there the
#   machine-id and the host key are bound to SHA-1, from the next boot on, and
#   only while it is on (off: neither, from the next boot). Elsewhere SHA-256,
#   whatever it says. SHA-1 is the weaker hash (SECURITY.md, "The SHA-1 bank").
# --pin-fd N / --lockout-auth-fd N: the secret from a file descriptor (every
#   byte; tests), never from the command line or the environment.
set -Eeuo pipefail

KEYS=/usr/share/safespace/secureboot
EFIVARS=/sys/firmware/efi/efivars
GLOBAL=8be4df61-93ca-11d2-aa0d-00e098032b8c
IMGSEC=d719b2cb-3d3a-4596-a3bc-dad00e67656f

die() { printf '\e[1;31m==> ERROR:\e[0m %s\n' "$*" >&2; exit 1; }
log() { printf '\e[1;32m==>\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m==> WARNING:\e[0m %s\n' "$*" >&2; }

REPLACE=0 CONFIRM=1 IDENTITY="" PIN_FD="" LOCKOUT_FD="" SHA1="" MOVE_TO=""
fd_arg() { [[ ${1:-} =~ ^[0-9]+$ ]] || die "$2 needs a file descriptor number"; echo "$1"; }
while (($#)); do
	case $1 in
		--replace) REPLACE=1; shift ;;
		--yes) CONFIRM=0; shift ;;
		--identity) IDENTITY=show; shift ;;
		--identity-create) IDENTITY=create; shift ;;
		--approve) IDENTITY=approve; shift ;;
		--move) IDENTITY=move; shift; [[ ${1:-} =~ ^[a-z][a-z0-9-]*$ ]] && { MOVE_TO=$1; shift; } ;;
		--identity-clear) IDENTITY=clear; shift ;;
		--sha1) [[ ${2:-} == on || ${2:-} == off ]] || die "--sha1 needs on or off"; SHA1=$2; shift 2 ;;
		--pin-fd) PIN_FD=$(fd_arg "${2:-}" --pin-fd); shift 2 ;;
		--lockout-auth-fd) LOCKOUT_FD=$(fd_arg "${2:-}" --lockout-auth-fd); shift 2 ;;
		-h|--help) sed -n '2,${/^#/!q;s/^# \?//;p}' "$0"; exit 0 ;;
		*) die "unknown option $1" ;;
	esac
done

# The selection variables' vendor GUID (safespace-select, the initrd's select).
SELECT_GUID=8a3e6c1d-4b2f-4e9a-b7d5-1c0f9e2a6b34
# The machine's inventory ID: its machine-id, hashed for this application
# (machine-id(5): the machine-id itself stays confidential).
APP_ID=eda1fc8c35e94e2087addff88d0b4e91

# --- the identity (aSSH) --------------------------------------------------------
ASSH=/usr/bin/assh
ASSH_CONF=/etc/assh/assh.conf
# The CA's file: the EFI variable of assh.conf's ASSH_CA (aSSH's vendor GUID).
CA_VAR=$EFIVARS/SAFEasshCA-24415b90-39be-45c0-a9a3-d547ebe28ea0
# What the agent recorded at its start (ASSH_STATE), and its files.
STATE=/run/assh/agent.pcrs.json
CERT=/run/assh/host-cert.pub HOSTPUB=/run/assh/host.pub
booted() { cat /usr/lib/safespace/combination 2>/dev/null || echo "?"; }

# The slot that certified this boot's host key ("" for none), as the agent
# logged it.
certified_slot() {
	[[ -s $CERT ]] || return 0
	journalctl -b -u assh-agent.service -o cat 2>/dev/null | sed -n 's/.* through slot \([0-9]*\)$/\1/p' | tail -1
}

# A secret into the variable named $1: from the file descriptor $2 (every
# byte), else asked on the terminal ($3, twice when $4 is "new"). It stays in
# this shell's memory: assh gets it on a pipe (secret_fd), never on a command
# line, in the environment or on disk.
read_secret() { # VAR FD PROMPT [new]
	local v="" again=""
	if [[ -n $2 ]]; then
		IFS= read -r -d '' -u "$2" v || true
	else
		[[ -r /dev/tty ]] || die "no terminal to ask the $3 on (or: --pin-fd / --lockout-auth-fd)"
		IFS= read -rsp "$3: " v </dev/tty; echo >/dev/tty
		if [[ ${4:-} == new ]]; then
			IFS= read -rsp "$3 again: " again </dev/tty; echo >/dev/tty
			[[ $v == "$again" ]] || die "the two entries differ"
		fi
	fi
	[[ -n $v ]] || die "the $3 is empty"
	printf -v "$1" '%s' "$v"
}
# assh with the secret in $1 on file descriptor 3 (printf is a builtin: the
# secret is in no process's arguments).
assh_with() { # VAR ASSH-ARGS...
	local var=$1; shift
	"$ASSH" "$@" 3< <(printf '%s' "${!var}")
}

# The PCR banks the TPM has active (sysfs: the kernel lists allocated banks).
banks() { local d; for d in /sys/class/tpm/tpm0/pcr-*; do [[ -d $d ]] && printf '%s ' "${d##*/pcr-}"; done; return 0; }
# SHA-1 on (aSSH's flag in the TPM), as aSSH reads it; "" where it cannot.
sha1_allowed() { { "$ASSH" tpm sha1 --config "$ASSH_CONF" 2>/dev/null || true; } | sed -n 's/^sha1 allowed: \([a-z]*\).*/\1/p'; }

sha1_set() { # on | off
	[[ -x $ASSH && -r $ASSH_CONF ]] || die "this image has no aSSH ($ASSH, $ASSH_CONF)"
	[[ -e /dev/tpmrm0 ]] || die "no TPM 2.0 (/dev/tpmrm0)"
	local b
	b=$(banks)
	if [[ $1 == on ]]; then
		"$ASSH" tpm sha1 --config "$ASSH_CONF" --allow || die "allowing SHA-1 failed"
		if [[ " $b" == *" sha256 "* ]]; then
			log "SHA-1 is allowed, and changes nothing here: this TPM has the SHA-256 bank active (${b% })"
		else
			warn "SHA-1 is the weaker hash: the machine-id and the host key are bound to SHA-1 PCR values"
			log "SHA-1 is allowed: from the next boot the machine-id and the host key use it (the first boot with Secure Boot on gives the machine-id; then sudo safespace-seal --identity-create)"
		fi
	else
		"$ASSH" tpm sha1 --config "$ASSH_CONF" --forbid || die "forbidding SHA-1 failed"
		[[ " $b" == *" sha256 "* ]] || log "SHA-1 is forbidden: from the next boot this machine has no identity (its TPM has the SHA-1 bank only)"
	fi
	exit 0
}

identity_show() {
	echo "combination:   $(booted)"
	local b a
	b=$(banks) a=$(sha1_allowed)
	if [[ -n $b && " $b" != *" sha256 "* ]]; then
		case $a in
			yes) echo "PCR bank:      sha1 (the TPM has no SHA-256 bank; allowed: safespace-seal --sha1 on)" ;;
			no) echo "PCR bank:      none: the TPM has the SHA-1 bank only, and SHA-1 is not allowed (sudo safespace-seal --sha1 on)" ;;
			*) echo "PCR bank:      sha1 only (run as root to see whether SHA-1 is allowed)" ;;
		esac
	elif [[ -n $b ]]; then
		echo "PCR bank:      sha256"
	fi
	if [[ -e $EFIVARS/SafespaceIdMachine-$SELECT_GUID ]]; then
		if grep -qx SafespaceIdMachine /run/safespace/identity/released 2>/dev/null; then
			echo "machine-id:    the machine's (released in this combination); inventory ID $(systemd-id128 machine-id --app-specific=$APP_ID)"
		else
			echo "machine-id:    throwaway (the machine's is sealed to another combination)"
		fi
	else
		echo "machine-id:    throwaway (none sealed yet: the first boot with Secure Boot on creates it)"
	fi
	if [[ ! -e $CA_VAR ]]; then
		echo "identity:      none yet: sudo safespace-seal --identity-create"
	else
		echo "identity:      the CA in this TPM (SAFEasshCA):"
		"$ASSH" ca show --config "$ASSH_CONF" 2>&1 | sed 's/^/  /'
	fi
	local slot fp
	fp=$(ssh-keygen -lf "$HOSTPUB" 2>/dev/null | cut -d' ' -f2) || true
	slot=$(certified_slot)
	if [[ -n $slot ]]; then
		echo "this boot:     host key ${fp:-?}, certified by the CA through slot $slot"
		[[ $slot == 0 ]] || echo "               (slot 0 is not met: after an update, sudo safespace-seal --approve)"
	elif [[ -s $HOSTPUB ]]; then
		echo "this boot:     host key ${fp:-?} TEMPORARY (not certified: compare its fingerprint before trusting it)"
		[[ -e $CA_VAR ]] && echo "               (another combination, or Secure Boot changed: sudo safespace-seal --move to have the identity here)"
	else
		echo "this boot:     no host key of aSSH (no TPM 2.0: a throwaway key)"
	fi
}

# An EFI variable of the selection's vendor GUID: gone (immutable flag lifted first).
sel_var_rm() { local f=$EFIVARS/$1-$SELECT_GUID; [[ -e $f ]] || return 0; chattr -i "$f" 2>/dev/null || true; rm -f "$f"; }
# ... written: the attributes (NV, BS, RT), then the value, in one write.
sel_var_write() { sel_var_rm "$1"; printf '\x07\x00\x00\x00%s' "$2" >"$EFIVARS/$1-$SELECT_GUID"; }

identity_clear() {
	if ((CONFIRM)); then
		read -rp "Remove this machine's identity (the CA, its PIN, the machine-id)? Clients that trust the CA will refuse it. Type YES: " answer
		[[ $answer == YES ]] || die "aborted"
	fi
	"$ASSH" ca remove --config "$ASSH_CONF" || die "removing the CA failed"
	local v
	for v in SafespaceIdMachine SafespaceAssign SafespaceAssignId; do
		sel_var_rm "$v" || die "could not remove $v"
	done
	log "the identity is removed. sshd serves the temporary key; from the next boot with Secure Boot on the machine has a new machine-id. A new identity: sudo safespace-seal --identity-create"
	exit 0
}

identity() { # show | create | approve | move | clear
	[[ $1 == show ]] && { identity_show; exit 0; }
	[[ -x $ASSH && -r $ASSH_CONF ]] || die "this image has no aSSH ($ASSH, $ASSH_CONF)"
	[[ -e /dev/tpmrm0 ]] || die "no TPM 2.0 (/dev/tpmrm0): the identity is the TPM's"
	[[ $1 == clear ]] && identity_clear
	# The state approved holds PCR 7: Secure Boot on, with this stick's keys.
	[[ $setup == 0 && $sb == 1 ]] ||
		die "Secure Boot is not on (SetupMode=${setup:-?} SecureBoot=${sb:-?}): seal first, switch it on, boot again"
	[[ -s $STATE ]] || die "the agent recorded no state this boot ($STATE: systemctl status assh-agent)"
	local name pin="" lockout=""
	name=$(booted)
	case $1 in
		create)
			[[ ! -e $CA_VAR ]] || die "this machine has an identity already (safespace-seal --identity); --move moves it here"
			if "$ASSH" tpm da --config "$ASSH_CONF" 2>&1 | grep -q "no lockout authorization"; then
				log "the TPM has no lockout authorization: set one now. It resets a PIN lockout and clears the TPM: keep it off this machine"
				read_secret lockout "$LOCKOUT_FD" "new lockout authorization" new
				assh_with lockout tpm da --config "$ASSH_CONF" --new-lockout-auth-fd 3 \
					--max-tries 3 --recovery 1800 --lockout-recovery 1800 || die "setting the lockout authorization failed"
				lockout=""
			else
				log "the TPM's lockout authorization is set already: kept"
			fi
			log "the identity's PIN: 3 wrong entries lock it for 30 minutes"
			read_secret pin "$PIN_FD" "new PIN" new
			assh_with pin ca create --config "$ASSH_CONF" --pin-fd 3 >/dev/null || die "creating the CA failed"
			assh_with pin ca approve --config "$ASSH_CONF" --values "$STATE" --pin-fd 3 || die "approving this state failed"
			pin=""
			log "this machine's identity is created, for $name. The next boot certifies its host key; until then sshd serves the temporary one."
			"$ASSH" ca show --config "$ASSH_CONF" | sed -n '/known_hosts line/,+1p'
			;;
		approve)
			[[ -e $CA_VAR ]] || die "no identity yet: sudo safespace-seal --identity-create"
			local slot
			slot=$(certified_slot)
			[[ -n $slot ]] || die "this boot was not certified: another combination, or a Secure Boot change - sudo safespace-seal --move"
			[[ $slot != 0 ]] || { log "this boot was certified through slot 0: nothing to approve"; exit 0; }
			read_secret pin "$PIN_FD" "PIN"
			assh_with pin ca approve --config "$ASSH_CONF" --values "$STATE" --pin-fd 3 || die "approving this state failed"
			pin=""
			log "this state of $name is approved: the next boot certifies through slot 0"
			;;
		move)
			[[ -e $CA_VAR ]] || die "no identity yet: sudo safespace-seal --identity-create"
			[[ -z $MOVE_TO || $MOVE_TO == "$name" ]] || move_to "$MOVE_TO"
			[[ -z $(certified_slot) ]] || die "this boot was certified: $name holds the identity already (after an update: --approve; to another combination: --move NAME)"
			if ((CONFIRM)); then
				read -rp "Move this machine's identity to '$name'? Every other combination loses it. Type YES: " answer
				[[ $answer == YES ]] || die "aborted"
			fi
			read_secret pin "$PIN_FD" "PIN"
			assh_with pin ca approve --config "$ASSH_CONF" --values "$STATE" --next-generation --pin-fd 3 || die "approving this state failed"
			pin=""
			# The machine-id follows, at the next boot (the initrd seals a new one
			# for $name), and $name stays the combination booted.
			sel_var_rm SafespaceAssignId
			sel_var_write SafespaceAssign "$name" || die "could not write SafespaceAssign"
			safespace-select set "$name" >/dev/null || warn "safespace-select set $name failed: select it to keep booting it"
			log "the identity is $name's: every approval before is revoked. Reboot: the next boot certifies, and gets the machine-id"
			;;
	esac
	exit 0
}
# --move NAME from this boot: NAME's state approved ahead (identity() checked
# the CA, Secure Boot and the recorded state).
move_to() { # NAME
	local to=$1 mid=""
	# The UKI's command line names every combination of this build.
	grep -q "safespace\.root\.$to=" /proc/cmdline || die "$to is no combination of this build (safespace-select list)"
	if ((CONFIRM)); then
		read -rp "Move this machine's identity to '$to'? Every other combination loses it, $name too. Type YES: " answer
		[[ $answer == YES ]] || die "aborted"
	fi
	read_secret pin "$PIN_FD" "PIN"
	assh_with pin ca approve --config "$ASSH_CONF" --values "$STATE" \
		--events "15:safespace-combination:$to" --events "15:safespace-identity:sealed" --next-generation --pin-fd 3 ||
		die "approving $to's state failed"
	pin=""
	# The machine-id moves with it, where it is released in this boot.
	if grep -qx SafespaceIdMachine /run/safespace/identity/released 2>/dev/null; then
		mid=$(cat /run/safespace/identity/machine-id)
	fi
	sel_var_rm SafespaceAssignId
	[[ -z $mid ]] || sel_var_write SafespaceAssignId "$mid" || die "could not write SafespaceAssignId"
	sel_var_write SafespaceAssign "$to" || die "could not write SafespaceAssign"
	safespace-select set "$to" >/dev/null || warn "safespace-select set $to failed: select it to boot it"
	if [[ -n $mid ]]; then
		log "the identity is $to's: every approval before is revoked. Reboot: $to's next boot is certified and keeps this machine-id"
	else
		log "the identity is $to's: every approval before is revoked. Reboot: $to's next boot is certified, with a new machine-id (the machine's is not released in this boot)"
	fi
	exit 0
}
[[ $IDENTITY == show ]] && identity show

[[ $EUID -eq 0 ]] || die "must run as root"
[[ -z $SHA1 ]] || sha1_set "$SHA1"
[[ -d $EFIVARS ]] || die "not booted in UEFI mode"
[[ -f $KEYS/PK.auth ]] || die "this image contains no Secure Boot keys (build it with build.sh, which exports them)"
mountpoint -q "$EFIVARS" || mount -t efivarfs efivarfs "$EFIVARS"
grep -q " $EFIVARS efivarfs rw" /proc/mounts || mount -o remount,rw "$EFIVARS"

# Value byte of a global UEFI variable (after the 4-byte attribute header).
var_byte() { od -An -tu1 -j4 -N1 "$EFIVARS/$1-$GLOBAL" 2>/dev/null | tr -d ' '; }
# Certificate subjects in a signature-database variable.
list_var() { # name guid
	local f=$EFIVARS/$1-$2
	[[ -s $f ]] || { echo "    (empty)"; return; }
	tail -c +5 "$f" >/tmp/.seal-$1.esl
	sig-list-to-certs /tmp/.seal-$1.esl /tmp/.seal-$1 >/dev/null 2>&1 || true
	local found=0 c
	for c in /tmp/.seal-$1-*.der; do
		[[ -e $c ]] || continue
		found=1
		echo "    $(openssl x509 -inform der -in "$c" -noout -subject -nameopt oneline 2>/dev/null | sed 's/^subject=//')"
	done
	((found)) || echo "    (entries without certificate, e.g. hashes)"
	rm -f /tmp/.seal-$1*
}

setup=$(var_byte SetupMode)
sb=$(var_byte SecureBoot)
log "SetupMode=${setup:-?} SecureBoot=${sb:-?}"

[[ -z $IDENTITY ]] || identity "$IDENTITY"
[[ $setup == 1 ]] || die "the machine is not in Setup Mode. In the firmware setup choose \"Reset to Setup Mode\" or \"Clear Secure Boot keys\", then boot this stick again."

echo "Currently enrolled:"
for v in PK KEK; do echo "  $v:"; list_var $v $GLOBAL; done
for v in db dbx; do echo "  $v:"; list_var $v $IMGSEC; done
echo "Will enroll (signed by the keys of this stick):"
for k in PK KEK db; do
	printf '  %-4s %s\n' "$k" "$(openssl x509 -in "$KEYS/$k.pem" -noout -subject -nameopt oneline | sed 's/^subject=//')"
done
if ((REPLACE)); then
	warn "--replace: db and KEK will contain ONLY these keys. Devices with option ROMs signed by Microsoft (GPUs, NICs, RAID controllers) will stop working in firmware, which can leave the machine without display or unbootable."
else
	echo "Mode: append (certificates already in KEK/db are kept)"
fi
if ((CONFIRM)); then
	read -rp "Type YES to enroll: " answer
	[[ $answer == YES ]] || die "aborted"
fi

# Existing variables are immutable in efivarfs.
for v in KEK-$GLOBAL db-$IMGSEC PK-$GLOBAL; do
	[[ -e $EFIVARS/$v ]] && chattr -i "$EFIVARS/$v"
done

suffix=-append
((REPLACE)) && suffix=
args=()
((REPLACE)) || args=(-a)
# db and KEK first: writing PK ends Setup Mode, after which only signed
# updates verified against the new PK/KEK are accepted.
log "Enrolling db";  efi-updatevar "${args[@]}" -f "$KEYS/db$suffix.auth" db
log "Enrolling KEK"; efi-updatevar "${args[@]}" -f "$KEYS/KEK$suffix.auth" KEK
log "Enrolling PK";  efi-updatevar -f "$KEYS/PK.auth" PK

setup=$(var_byte SetupMode)
[[ $setup == 0 ]] || die "SetupMode is still ${setup:-?}: the firmware did not accept PK"
log "Sealed. The firmware is in User Mode with this stick's keys."
echo "Next: reboot, make sure Secure Boot is ENABLED in the firmware setup, and set a firmware password."
echo "The first boot with Secure Boot on gives this machine its machine-id, bound to the combination that boots"
echo "(safespace-select set NAME before rebooting chooses it). Then, in that boot: sudo safespace-seal --identity-create"
echo "(the ssh host key's CA in the TPM, PIN)."
