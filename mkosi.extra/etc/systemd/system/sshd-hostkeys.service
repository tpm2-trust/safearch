# Replaces Arch's sshdgenkeys.service, which writes to the read-only /etc/ssh.
# Only without a TPM 2.0: then aSSH (assh-agent.service) cannot make the host
# key, and sshd gets a throwaway ed25519 key, new on every boot, in /var.
[Unit]
Description=SSH host key without a TPM: a throwaway one
Before=sshd.service
RequiresMountsFor=/var/lib
ConditionPathExists=!/dev/tpmrm0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/install -d -m 0755 /var/lib/sshd/etc/ssh /run/safespace
ExecStart=/bin/sh -c 'k=/var/lib/sshd/etc/ssh/ssh_host_ed25519_key; [ -s "$k" ] || ssh-keygen -q -t ed25519 -N "" -C "" -f "$k"; echo "HostKey $k" >/run/safespace/sshd-hostkey.conf; echo "host key: throwaway (no TPM 2.0)"'
