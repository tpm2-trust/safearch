# aSSH's settings (assh/README.md, "The settings in one file"): the machine's
# host key in the TPM, certified by its CA (SECURITY.md, "Machine identity").
# Generated by build.sh (lib/settings.sh) from lib/assh.conf.in and the identity
# policy of safespace.conf: the same file in the root and the initrd, in every
# combination.

# The CA: in an EFI variable, made by the initrd at the first boot with Secure
# Boot on (mkosi.initrd.conf/.../identity), with the machine-id; its private key
# never leaves the TPM.
ASSH_CA=efi:@CA_VAR@
# Its authority exists for that moment alone: it approves the slots below and is
# gone. Nothing can approve another state after; a new identity: safespace
# identity clear.
ASSH_AUTHORITY_ONCE=yes
ASSH_CA_REF="safespace identity"
# The PCR bank (safespace.conf's PCR_BANK).
ASSH_CA_BANK=@PCR_BANK@
# The slots, tried in order (safespace.conf's IDENTITY_SLOTS). PCR 15 holds the
# combination (the initrd's select, then identity's "sealed"): every slot is per
# combination.
@SLOTS@
# The build's PCR signing key (in the initrd, where the CA is made: lib/compose.sh
# appends it) and its signatures of the booted UKI, as systemd hands them over.
ASSH_PCR_KEY=/usr/local/lib/safespace/pcr.pem
ASSH_PCR_SIGNATURE=/run/systemd/tpm2-pcr-signature.json
# PCR 15 is also the window: the agent extends it once the host key is
# certified, so the CA signs nothing more until the next boot.
ASSH_CA_WINDOW=@PCR@
ASSH_KEY_ID=safespace
# The PCR state at the agent's start.
ASSH_STATE=/run/assh/agent.pcrs.json
ASSH_AGENT_DIR=/run/assh
# The key types, the first the TPM takes (safespace.conf's KEY_TYPES). The agent
# offers rsa-sha2-512 only where the TPM has SHA-512.
ASSH_CA_TYPE=@KEY_TYPES@
ASSH_HOSTKEY_TYPE=@KEY_TYPES@
