#!/bin/bash
# Runs after the outputs exist in $OUTPUTDIR, before they move to mkosi.output/.
set -euo pipefail

# Firmware loads the whole UKI into memory, over its own (slow) USB driver or
# over the network; a few hundred MiB fails or stalls on many machines.
# The netboot UKI is the stricter case: firmware loads it as a network boot
# program, and some cannot start a large one (ThinkPad T450s: 80 MiB fine,
# 112 MiB not, the limit is in between; see NETBOOT.md). Its initrd is trimmed
# for that (mkosi.profiles/network/, mkosi.initrd.conf/mkosi.profiles/network/).
# Above the warning size the build continues but says so; above the limit it
# fails. Both per host, e.g. in mkosi.local.conf:
#   [Build]
#   Environment=SAFESPACE_UKI_WARN_MIB=90 SAFESPACE_UKI_LIMIT_MIB=100
case " ${PROFILES:-} " in
	*" network "*) warn_mib=${SAFESPACE_UKI_WARN_MIB:-80} limit_mib=${SAFESPACE_UKI_LIMIT_MIB:-128} ;;
	*) warn_mib=${SAFESPACE_UKI_WARN_MIB:-100} limit_mib=${SAFESPACE_UKI_LIMIT_MIB:-100} ;;
esac
for v in warn_mib limit_mib; do
	[[ ${!v} =~ ^[1-9][0-9]*$ ]] || { echo "safespace: ERROR: SAFESPACE_UKI_${v^^}=${!v} is not a number" >&2; exit 1; }
done
for uki in "$OUTPUTDIR"/*.efi; do
	[[ -e $uki ]] || continue
	bytes=$(stat -c %s "$uki")
	echo "safespace: UKI $(basename "$uki"): $((bytes / 1048576)) MiB (warning above $warn_mib MiB, limit $limit_mib MiB)"
	# Where the size comes from, so growth is visible at build time.
	if command -v objdump >/dev/null; then
		objdump -h "$uki" | awk '$2 ~ /^\.(linux|initrd|ucode)$/ { printf "safespace:   %-8s %4d MiB\n", $2, strtonum("0x" $3) / 1048576 }' || true
	fi
	((bytes <= limit_mib * 1048576)) || { echo "safespace: ERROR: UKI larger than $limit_mib MiB" >&2; exit 1; }
	((bytes <= warn_mib * 1048576)) ||
		echo "safespace: WARNING: UKI larger than $warn_mib MiB: some firmware cannot start a network boot program this large (NETBOOT.md, \"Size of the network UKI\")" >&2
done

# The netboot UKI is useless without the URL it should load its root from.
case " ${PROFILES:-} " in
	*" network "*)
		for uki in "$OUTPUTDIR"/*.efi; do
			[[ -e $uki ]] || continue
			if command -v objcopy >/dev/null; then
				cmdline=$(objcopy -O binary --only-section=.cmdline "$uki" /dev/stdout 2>/dev/null | tr -d '\0')
			else
				cmdline=$(grep -ao 'safespace\.netroot=[^ ]*' "$uki" | tr '\n' ' ')
			fi
			[[ $cmdline == *safespace.netroot=* ]] ||
				{ echo "safespace: ERROR: no safespace.netroot= in the UKI command line (build with ./build.sh network)" >&2; exit 1; }
			echo "safespace: netroot URL(s): $(tr ' ' '\n' <<<"$cmdline" | sed -n 's/^safespace.netroot=//p' | tr '\n' ' ')"
		done
		;;
esac

# The keys shipped for safespace-seal must be the ones the UKI is signed with,
# or a machine sealed from this stick refuses to boot it.
# build.sh exports them before every build; a missing export means mkosi was
# run directly.
keys=$SRCDIR/mkosi.extra/usr/share/safespace/secureboot
if [[ ! -f $keys/db.pem || ! -f $keys/PK.auth ]]; then
	echo "safespace: ERROR: no Secure Boot keys in the image, safespace-seal would not work (build with ./build.sh)" >&2
	exit 1
fi
# Only public material: certificates, signed updates, the GUID.
for f in "$keys"/* "$keys"/.[!.]*; do
	[[ -e $f ]] || continue
	case ${f##*/} in
		PK.pem | KEK.pem | db.pem | PK.auth | KEK.auth | db.auth | KEK-append.auth | db-append.auth | GUID) ;;
		*) echo "safespace: ERROR: unexpected file in the shipped Secure Boot keys: $f" >&2; exit 1 ;;
	esac
done
if grep -alq -- 'PRIVATE KEY' "$keys"/*; then
	echo "safespace: ERROR: private key material in $keys" >&2
	exit 1
fi
for uki in "$OUTPUTDIR"/*.efi; do
	[[ -e $uki ]] || continue
	signer=$(python3 -I - "$uki" <<-'EOF' | openssl pkcs7 -inform DER -print_certs | openssl x509 -noout -fingerprint -sha256
		import struct, sys
		d = open(sys.argv[1], 'rb').read()
		opt = struct.unpack_from('<I', d, 0x3c)[0] + 24
		dd = opt + (112 if struct.unpack_from('<H', d, opt)[0] == 0x20b else 96)
		off, size = struct.unpack_from('<II', d, dd + 32)
		if not size: sys.exit('UKI is not signed')
		length = struct.unpack_from('<I', d, off)[0]
		sys.stdout.buffer.write(d[off + 8:off + length])
	EOF
	)
	shipped=$(openssl x509 -in "$keys/db.pem" -noout -fingerprint -sha256)
	if [[ $signer != "$shipped" ]]; then
		echo "safespace: ERROR: UKI is signed by a different key than the db.pem shipped for safespace-seal" >&2
		echo "  UKI:     $signer" >&2
		echo "  shipped: $shipped" >&2
		echo "  Rerun secureboot-export.sh with the keys of SecureBootKey=, then rebuild." >&2
		exit 1
	fi
	echo "safespace: UKI signed by the shipped db key (safespace-seal can enroll it)"
done
